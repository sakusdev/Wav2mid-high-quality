{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wav2mid-high-quality",
  "main": "worker.js",
  "compatibility_date": "2026-08-19",
  "build": {
    "command": "node scripts/require-muscriptor-model.mjs --root=dist"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/models/muscriptor-small/*"
    ]
  }
}
