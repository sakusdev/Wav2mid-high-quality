{
  "name": "wav2mid-high-quality",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare-runtime": "node scripts/copy-runtime.mjs",
    "prepare:muscriptor-workers": "node scripts/prepare-muscriptor-workers-build.mjs",
    "dev": "npm run prepare-runtime && vite",
    "build": "npm run prepare:muscriptor-workers && npm run prepare-runtime && vite build && node scripts/check-static-assets.mjs --limit-mib=25",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:bench:syntax": "node --check scripts/benchmark-metrics.mjs && node --check scripts/browser-bench-runner.mjs && node --check scripts/benchmark-suite.mjs && node --check scripts/tune.mjs && node --check scripts/prepare-maestro-manifest.mjs && node --check scripts/prepare-slakh-manifest.mjs && node --check scripts/create-benchmark-smoke-fixture.mjs",
    "test:bench:smoke": "node scripts/create-benchmark-smoke-fixture.mjs && node scripts/benchmark-suite.mjs --manifest .benchmark-smoke/manifest.json --adapters .benchmark-smoke/adapters.json --adapter wav2mid-fast-smoke --split test --max-items 1 --no-build --output .benchmark-smoke/results --cache .benchmark-smoke/cache --min-objective 0.20",
    "benchmark:reference": "node scripts/compare-reference.mjs",
    "benchmark:suite": "node scripts/benchmark-suite.mjs",
    "benchmark:prepare-maestro": "node scripts/prepare-maestro-manifest.mjs",
    "benchmark:prepare-slakh": "node scripts/prepare-slakh-manifest.mjs",
    "tune": "node scripts/tune.mjs",
    "check:temporary-assets": "node scripts/check-static-assets.mjs --limit-mib=5",
    "check:muscriptor-model": "node scripts/require-muscriptor-model.mjs --root=public",
    "check:muscriptor-dist": "node scripts/require-muscriptor-model.mjs --root=dist",
    "deploy": "npm run build && npm run check:muscriptor-dist && wrangler deploy",
    "deploy:temporary": "npm run build && npm run check:temporary-assets && npm run check:muscriptor-dist && wrangler deploy --temporary"
  },
  "dependencies": {
    "@spotify/basic-pitch": "1.0.1",
    "@tensorflow/tfjs": "4.21.0",
    "@tensorflow/tfjs-backend-wasm": "4.21.0",
    "@tensorflow/tfjs-backend-webgpu": "4.21.0",
    "@tonejs/midi": "2.0.28",
    "demucs-web": "1.0.2",
    "fft.js": "4.0.4",
    "onnxruntime-web": "1.27.0"
  },
  "overrides": {
    "@spotify/basic-pitch": {
      "@tensorflow/tfjs": "4.21.0"
    }
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "vite": "5.4.14",
    "wrangler": "4.125.0"
  }
}
